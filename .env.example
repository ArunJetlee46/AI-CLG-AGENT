# === App ===
APP_NAME=Beru Campus AI
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Databases ===
DATABASE_URL=sqlite:///./beru.db
# PostgreSQL (docker): postgresql+psycopg2://beru:beru@localhost:5432/beru
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=beru-neo4j
QDRANT_URL=http://localhost:6333
VECTOR_STORE_BACKEND=qdrant

# === LLM providers (free tiers; leave empty to degrade gracefully) ===
LLM_PROVIDER_ORDER=groq,gemini,ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=30
LLM_CIRCUIT_BREAKER_FAILURES=3

# === Embeddings / RAG ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=bge-reranker-base
RAG_TOP_K=4
RAG_CANDIDATES=20

# === Curriculum RAG (in-process, merged from the former college-ai service) ===
CURRICULUM_RAG_ENABLED=true
CURRICULUM_RAG_JSONL=../data/anna_university_aids_reg2021_rag.jsonl
CURRICULUM_COURSE_INDEX_JSON=../data/course_index.json
CURRICULUM_COLLECTION=curriculum_documents
CURRICULUM_SIMILARITY_THRESHOLD=0.35

# === ML ===
MLFLOW_TRACKING_URI=http://localhost:5000
PREDICTION_MODEL_PATH=models/risk_model.joblib

# === Auth seed (created on first boot) ===
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

# === Observability ===
SENTRY_DSN=
